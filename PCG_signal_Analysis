        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "def median_filter(x, k):\n",
        "    \"\"\"Applies a median filter of kernel size k to signal x.\"\"\"\n",
        "    n = len(x)\n",
        "    y = np.zeros(n)\n",
        "    half = k // 2\n",
        "    for i in range(n):\n",
        "        start = max(i - half, 0)\n",
        "        end = min(i + half + 1, n)\n",
        "        y[i] = np.median(x[start:end])\n",
        "    return y\n",
