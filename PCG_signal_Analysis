        "\n",
        "order_values = [4, 6, 8, 10]\n",
        "\n",
        "\n",
        "butter_filtered_signals = {}\n",
        "rsnr_results = {}\n",
        "\n",
        "for s in snr_values:\n",
        "    print(f\"\\n--- Processing SNR = {s} dB ---\")\n",
        "    noisy = noisy_signals[s]\n",
        "\n",
        "    butter_filtered_signals[s] = {}\n",
        "    rsnr_results[s] = {}\n",
        "\n",
        "\n",
        "    best_rsnr = -np.inf\n",
        "    best_order = 0\n",
        "    best_filtered_signal = None\n",
        "\n",
        "\n",
        "    for order in order_values:\n",
        "\n",
        "        # 1. Get filter coefficients\n",
        "        b, a = butter(order, [f1, f2], btype='band', fs=fs)\n",
        "\n",
        "        # 2. Apply the zero-phase filter\n",
        "        y_fwd = lfilter(b, a, noisy)\n",
        "        y_rev = lfilter(b, a, y_fwd[::-1])\n",
        "        y_zero_phase = y_rev[::-1]\n",
        "\n",
        "        # 3. Store the signal\n",
        "        butter_filtered_signals[s][order] = y_zero_phase\n",
        "\n",
        "        # 4. Calculate and store RSNR\n",
        "        rsnr_val = rsnr(signal, y_zero_phase)\n",
        "        rsnr_results[s][order] = rsnr_val\n",
        "\n",
        "        # 5. Check if this is the new best\n",
        "        if rsnr_val > best_rsnr:\n",
        "            best_rsnr = rsnr_val\n",
        "            best_order = order\n",
        "            best_filtered_signal = y_zero_phase\n",
        "\n",
        "    plt.figure(figsize=(12, 4))\n",
        "    plt.plot(t[:2*fs], noisy[:2*fs], alpha=0.5, label='Noisy', color='gray')\n",
