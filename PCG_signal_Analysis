        "fs = 2000\n",
        "f1, f2 = 20, 500\n",
        "N = 50\n",
        "M = (N - 1) // 2\n",
        "\n",
        "f1_n = f1 / fs\n",
        "f2_n = f2 / fs\n",
        "\n",
        "n = np.arange(N)\n",
        "h_ideal = (2*f2_n*np.sinc(2*f2_n*(n - M))) - (2*f1_n*np.sinc(2*f1_n*(n - M)))\n",
        "\n",
        "\n",
        "def hamming(N):\n",
        "    n = np.arange(N)\n",
        "    return 0.54 - 0.46 * np.cos(2 * np.pi * n / (N - 1))\n",
        "\n",
        "def hann(N):\n",
        "    n = np.arange(N)\n",
        "    return 0.5 - 0.5 * np.cos(2 * np.pi * n / (N - 1))\n",
        "\n",
        "def blackman(N):\n",
        "    n = np.arange(N)\n",
        "    return 0.42 - 0.5 * np.cos(2 * np.pi * n / (N - 1)) + 0.08 * np.cos(4 * np.pi * n / (N - 1))\n",
        "\n",
        "def bartlett(N):\n",
        "    n = np.arange(N)\n",
        "    return 1 - np.abs((n - (N-1)/2) / ((N-1)/2))\n",
        "\n",
        "windows = {\n",
        "    \"Hamming\": hamming(N),\n",
        "    \"Hann\": hann(N),\n",
        "    \"Blackman\": blackman(N),\n",
        "    \"Bartlett\": bartlett(N)\n",
        "}\n",
        "\n",
        "filters = {}\n",
        "for name, w in windows.items():\n",
        "    h_win = h_ideal * w\n",
        "    h_win = h_win / np.sum(h_win)\n",
        "    filters[name] = h_win\n",
