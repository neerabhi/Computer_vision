        "def gaussian_kernel(k, sigma):\n",
        "    x = np.arange(-k//2 + 1, k//2 + 1)\n",
        "    g = np.exp(-(x**2)/(2*sigma**2))\n",
        "    g /= np.sum(g)\n",
        "    return g\n",
        "\n",
        "def gaussian_filter(x, k, sigma):\n",
        "    kernel = gaussian_kernel(k, sigma)\n",
        "    n = len(x)\n",
        "    y = np.zeros(n)\n",
        "    half = k // 2\n",
        "    for i in range(n):\n",
        "        start = max(i - half, 0)\n",
        "        end = min(i + half + 1, n)\n",
        "        segment = x[start:end]\n",
        "        kernel_seg = kernel[half-(i-start):half+(end-i)]\n",
        "        y[i] = np.sum(segment*kernel_seg)\n",
        "    return y"
      ]
