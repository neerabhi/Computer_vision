        "        if signal.dtype == object:\n",
        "            signal = signal.item()\n",
        "        # Check if the signal item is an ndarray and extract the first column\n",
        "        if isinstance(signal, np.ndarray) and signal.ndim > 1 and signal.shape[1] > 1:\n",
        "            signal = signal[:, 0]\n",
        "    except Exception:\n",
        "        try:\n",
        "            signal = hs['Data'][0, 0]\n",
        "            if isinstance(signal, np.ndarray) and signal.ndim > 1 and signal.shape[1] > 1:\n",
        "                 signal = signal[:, 0]\n",
        "        except Exception:\n",
        "            signal = np.asarray(hs).squeeze()\n",
        "else:\n",
        "    signal = hs\n",
        "\n",
        "signal = np.asarray(signal).squeeze()\n",
        "if signal.ndim > 1:\n",
        "    if signal.shape[0] > 1 and signal.shape[1] > 1:\n",
