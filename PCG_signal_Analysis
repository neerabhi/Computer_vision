        "\n",
        "fs = 2000\n",
        "\n",
        "# Normalize (zero mean, unit max)\n",
        "signal = signal - np.mean(signal)\n",
        "signal = signal / (np.max(np.abs(signal)) + 1e-12)\n",
        "\n",
        "original_signal = signal.copy()\n",
        "\n",
        "\n",
        "def add_awgn(x, snr_db):\n",
        "    sig_power = np.mean(x**2)\n",
        "    noise_power = sig_power / (10**(snr_db/10))\n",
        "    noise = np.random.normal(0, np.sqrt(noise_power), len(x))\n",
        "    noisy = x + noise\n",
        "    actual_snr = 10 * np.log10(np.mean(x**2) / np.mean(noise**2))\n",
        "    return noisy, actual_snr\n",
        "\n",
        "threshold = 0.2\n",
        "signal_clipped = signal.copy()\n",
        "indices = np.where(np.abs(signal) > threshold)[0]\n",
        "\n",
        "for i in indices:\n",
        "    left = max(i-100, 0)\n",
        "    right = min(i+100, len(signal))\n",
        "    signal_clipped[i] = np.median(signal[left:right])\n",
